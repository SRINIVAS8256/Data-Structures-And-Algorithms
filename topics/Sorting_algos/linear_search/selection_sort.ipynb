   "source": [
    "# ⏱️ Time: O(n²) in best, average, and worst cases\n",
    "# 💾 Space: O(1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "babbdacb-6a09-4a03-ae4f-c4e1a4d8aabd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0, 1, 2, 5, 3, 15]\n"
     ]
    }
   ],
   "source": [
    "arr=[5,1,3,15,2,0]\n",
    "for i in range (0,len(arr)-1):\n",
    "    minimum = i\n",
    "    for j in range(i,len(arr)):\n",
    "        if arr[j]<arr[i]:\n",
    "            minimum=j\n",
    "    arr[i],arr[minimum]=arr[minimum],arr[i]\n",
    "print(arr)\n",
    "    "
   ]
  }
