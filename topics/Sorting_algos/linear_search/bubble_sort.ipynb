   "source": [
    "# Time Complexity: O(n²) — best, average, and worst case\n",
    "# Space Complexity: O(1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "4a9929a0-bee4-4977-969f-dd2cd535ba67",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0, 1, 2, 3, 4, 8, 11, 14, 33]\n"
     ]
    }
   ],
   "source": [
    "arr=[11,1,3,4,8,0,2,33,14]\n",
    "n=len(arr)\n",
    "for i in range(n-1,0,-1):\n",
    "    for j in range(0,i):\n",
    "        if arr[j]>arr[j+1]:\n",
    "            arr[j+1],arr[j]=arr[j],arr[j+1]\n",
    "print(arr)"
   ]
  }
 ],
